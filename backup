/* Overlay semitransparente entre el fondo y el contenido,
     para que el texto se siga leyendo bien sobre la foto */
.gob-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #0e0d0db2;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: -1;
    pointer-events: none;
}

.gob-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #21b57a, transparent 70%);
    z-index: 2;
