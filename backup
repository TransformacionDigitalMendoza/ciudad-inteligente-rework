  /* Máscara que simula el efecto de "despliegue" de abajo hacia arriba
   que antes tenía el video (ahora el video está fixed/sticky para
   toda la sección y no puede clipearse a sí mismo).
   Arranca cubriendo todo el hero (oculta el video) y, al agregar
   .is-revealed, su clip-path se "come" desde abajo hacia arriba,
   dejando ver el video que está fijo detrás. */
.gob-abierto-hero-mask {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: rgb(244, 250, 255);
    clip-path: inset(0% 0 0% 0);
    -webkit-clip-path: inset(0% 0 0% 0);
    transition: clip-path 1.5s cubic-bezier(0.65, 0, 0.35, 1);
    -webkit-transition: -webkit-clip-path 1.2s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: clip-path;
}

.gob-abierto.is-revealed .gob-abierto-hero-mask {
    clip-path: inset(0% 0 100% 0);
    -webkit-clip-path: inset(0% 0 100% 0);
}

/* Overlay para incorporar contenido encima del video
   (títulos, texto, botones, etc.) */
.gob-abierto-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0000009f;
    z-index: 2;
    opacity: 0;
    transition: opacity 1.8s ease 0.6s;
}

.gob-abierto.is-revealed .gob-abierto-overlay {
    opacity: 1;
}

.gob-abierto-title {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 30%;
    color: aliceblue;
    text-align: center;
}

.gob-abierto-title h2 {
    font-size: 4rem;
    margin-bottom: 40px;
}


.gob-abierto-title h3 {
