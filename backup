/* ===== Contenedor 100% x 100% ===== */
#gob-abierto-main {
    width: 100%;
    height: 100vh;
    background: aliceblue;
    display: flex;
    flex-direction: column;
    padding: 3.5vh 3vw;
    position: relative;
    overflow: hidden;
}

#gob-abierto-main::before {
    content: "";
