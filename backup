/* ---------- Área de mensajes ---------- */
.messages-viewport {
    height: 540px;
    overflow: hidden;
    position: relative;
}

.messages {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
    gap: 10px;
    padding: 18px 16px;
    will-change: transform;
}

.bubble-row {
    display: flex;
    transition: transform .45s cubic-bezier(.22, .68, .16, 1), opacity .45s ease;
}

.bubble-row.received {
    justify-content: flex-start;
}

.bubble-row.sent {
    justify-content: flex-end;
}

.bubble {
    padding: 9px 12px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    box-shadow: 0 6px 14px -8px rgba(20, 10, 60, 0.2);
    box-sizing: border-box;
}

.bubble.received {
    background: var(--received-bg);
    border: 1px solid var(--received-border);
}

.bubble.sent {
    background: linear-gradient(135deg, var(--sent-2), var(--sent-1));
}

.line {
    height: 11px;
    border-radius: 5px;
}

.received .line {
    background: var(--line-received);
}

.sent .line {
    background: var(--line-sent);
}

/* Animación de entrada (nuevo mensaje) */
.bubble-row.enter {
    opacity: 0;
    transform: translateY(24px);
}

.bubble-row.enter-active {
    opacity: 1;
    transform: translateY(0);
}

/* Indicador de "escribiendo" */
.typing {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 12px 16px;
    background: var(--received-bg);
    border: 1px solid var(--received-border);
    border-radius: 10px;
    width: fit-content;
}

.typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-received);
    animation: bounce 1s infinite ease-in-out;
}

.typing span:nth-child(2) {
    animation-delay: .15s;
}

.typing span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes bounce {

    0%,
    60%,
    100% {
        transform: translateY(0);
        opacity: .5;
    }

    30% {
        transform: translateY(-4px);
        opacity: 1;
    }
}

