/* Wrapper que contiene el video de fondo.
   position: sticky + margin-bottom negativo lo "clava" a la pantalla
   durante todo el alto de la sección, sin ocupar espacio en el flujo,
   de modo que el resto de los contenedores se apilan encima. */
.gob-abierto-video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 70vh;
    margin-bottom: -100vh;
    z-index: 0;
    overflow: hidden;
}

.gob-abierto-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* Primer contenedor: presentación del bloque, se superpone al video fijo */
.gob-abierto-hero {
    position: relative;
    width: 100%;
    height: 70vh;
    z-index: 0;
}

.svg-gob-abierto-1 {
    position: absolute;
    z-index: 3;
    bottom: 0;
}

.svg-gob-abierto-2 {
    position: absolute;
    z-index: 2;
    bottom: 0;
}

