    flex-shrink: 0;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.5);
    background-color: aliceblue;
}

.avatar img {
    width: 100%;
    height: auto;
    object-fit: contain;
}

.header-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

