/* ===== Tarjeta ===== */
.gob-card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 2rem 1.8rem;
    padding-top: 300px;
    isolation: isolate;
